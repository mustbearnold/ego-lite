{
  "name": "ego-lite-electron",
  "version": "1.2.3",
  "description": "Electron desktop package for the ego lite Linux host",
  "author": {
    "name": "ego lite contributors",
    "email": "contact@citrolabs.ai",
    "url": "https://github.com/mustbearnold/ego-lite-linux"
  },
  "homepage": "https://github.com/mustbearnold/ego-lite-linux",
  "license": "MIT",
  "desktopName": "ego-lite",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "scripts": {
    "build:sdk": "npm --prefix ../../package/ego-browser run build",
    "start": "electron .",
    "test:agent-visuals": "xvfb-run --auto-servernum node test/agent-visuals.mjs",
    "test:bookmarks": "node test/bookmarks.mjs",
    "test:background-space": "xvfb-run --auto-servernum node test/background-space.mjs",
    "test:bookmark-controls": "ELECTRON_DISABLE_SANDBOX=1 xvfb-run --auto-servernum node test/bookmark-controls.mjs",
    "test:browser-sync": "node test/browser-sync.mjs",
    "test:browser-sync-electron": "ELECTRON_DISABLE_SANDBOX=1 xvfb-run --auto-servernum node test/browser-data-sync.mjs",
    "test:cookie-parity": "npm run build:sdk && xvfb-run --auto-servernum node test/cookie-inheritance.mjs",
    "test:cdp-boundary": "npm run build:sdk && ELECTRON_DISABLE_SANDBOX=1 xvfb-run --auto-servernum node test/cdp-boundary.mjs",
    "test:devtools": "ELECTRON_DISABLE_SANDBOX=1 xvfb-run --auto-servernum node test/devtools.mjs",
    "test:download-open": "node test/download-open.mjs",
    "test:extension-loading": "xvfb-run --auto-servernum node test/extension-loading.mjs",
    "test:find-in-page": "ELECTRON_DISABLE_SANDBOX=1 xvfb-run --auto-servernum node test/find-in-page.mjs",
    "test:fullscreen": "ELECTRON_DISABLE_SANDBOX=1 xvfb-run --auto-servernum node test/fullscreen.mjs",
    "test:history": "node test/history.mjs",
    "test:last-tab": "ELECTRON_DISABLE_SANDBOX=1 xvfb-run --auto-servernum node test/last-tab.mjs",
    "test:reading-list": "node test/reading-list.mjs",
    "test:import-data": "xvfb-run --auto-servernum node test/import-data.mjs",
    "test:migration-discovery": "node test/migration-discovery.mjs",
    "test:migration-prompt": "xvfb-run --auto-servernum node test/migration-prompt.mjs",
    "test:migration-prompt:multi": "xvfb-run --auto-servernum env EGO_LITE_TEST_MULTI_PROFILE=1 EGO_LITE_TEST_MIGRATION_CHOICE=migrate node test/migration-prompt.mjs",
    "test:migrated-tabs": "xvfb-run --auto-servernum node test/migrated-tabs.mjs",
    "test:password-migration": "node test/password-migration.mjs",
    "test:private-tabs": "xvfb-run --auto-servernum node test/private-tab-controls.mjs",
    "test:profile-cli": "xvfb-run --auto-servernum node test/profile-cli.mjs",
    "test:profiles": "xvfb-run --auto-servernum node test/profile-controls.mjs",
    "test:session-restore": "xvfb-run --auto-servernum node test/session-restore.mjs",
    "test:server-name": "ELECTRON_DISABLE_SANDBOX=1 xvfb-run --auto-servernum node test/server-name.mjs",
    "test:standalone-profile": "node test/standalone-profile.mjs",
    "test:tab-groups": "ELECTRON_DISABLE_SANDBOX=1 xvfb-run --auto-servernum node test/tab-groups.mjs",
    "test:url-routing": "ELECTRON_DISABLE_SANDBOX=1 xvfb-run --auto-servernum node test/url-routing.mjs",
    "test:profile-migration": "node test/profile-migration.mjs",
    "test:profile-migration:electron": "xvfb-run --auto-servernum env EGO_LITE_ELECTRON_MIGRATION=1 node test/profile-migration.mjs",
    "test:snapshot-contract": "node test/snapshot-contract.mjs",
    "test:space-restore": "npm run build:sdk && xvfb-run --auto-servernum node test/space-restore.mjs",
    "test:tab-controls": "xvfb-run --auto-servernum node test/tab-controls.mjs",
    "test:tab-audio": "ELECTRON_DISABLE_SANDBOX=1 xvfb-run --auto-servernum node test/tab-audio.mjs",
    "test:window-state": "xvfb-run --auto-servernum -s \"-screen 0 1600x1000x24\" node test/window-state.mjs",
    "test:update-controller": "node test/update-controller.mjs",
    "test:welcome": "ELECTRON_DISABLE_SANDBOX=1 xvfb-run --auto-servernum node test/welcome.mjs",
    "package:dir": "npm run build:sdk && electron-builder --linux dir",
    "package:appimage": "npm run build:sdk && electron-builder --linux AppImage",
    "package:linux": "npm run build:sdk && electron-builder --linux",
    "package:release": "npm run build:sdk && electron-builder --linux --publish always"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.citrolabs.ego-lite",
    "productName": "ego lite",
    "executableName": "ego-lite",
    "artifactName": "ego-lite-${version}.${ext}",
    "asar": true,
    "files": [
      "main.mjs",
      "bookmarks.mjs",
      "browser-sync.mjs",
      "browser-sync-worker.mjs",
      "downloads.mjs",
      "history.mjs",
      "migration-discovery.mjs",
      "preload.mjs",
      "reading-list.mjs",
      "update.mjs",
      "renderer/**"
    ],
    "extraResources": [
      {
        "from": "../linux/ego-browser.mjs",
        "to": "ego-lite/linux/ego-browser.mjs"
      },
      {
        "from": "../linux/server-name.mjs",
        "to": "ego-lite/linux/server-name.mjs"
      },
      {
        "from": "../../package/ego-browser/dist/out",
        "to": "ego-lite/sdk"
      },
      {
        "from": "../../skills/ego-browser",
        "to": "ego-lite/ego-browser"
      },
      {
        "from": "../../assets/logo.png",
        "to": "ego-lite/logo.png"
      }
    ],
    "linux": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Network;WebBrowser;",
      "maintainer": "ego lite contributors <contact@citrolabs.ai>",
      "synopsis": "Chromium browser for human and AI-agent workflows",
      "description": "Electron desktop package for the ego lite Linux host",
      "syncDesktopName": true,
      "icon": "../../assets/logo.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mustbearnold",
        "repo": "ego-lite-linux",
        "releaseType": "release"
      }
    ]
  }
}
